---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CouponCard from '../components/CouponCard.astro';
import FAQ from '../components/FAQ.astro';
import ReviewCards from '../components/ReviewCards.astro';
import ServiceAreaList from '../components/ServiceAreaList.astro';
import MaintenancePromo from '../components/MaintenancePromo.astro';
import CTABand from '../components/CTABand.astro';
import ContactForm from '../components/ContactForm.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { couponById } from '../data/coupons';
import { reviews } from '../data/reviews';
import { categoryNames, findByHref } from '../data/services';
import { business, SITE_URL, LAST_UPDATED, formatDate } from '../data/business';
import { md, plain } from '../lib/md';
import { faqNode, serviceNode } from '../lib/schema';
import type { Service } from '../data/types';

interface Props { s: Service }
const { s } = Astro.props;
const url = `${SITE_URL}/${s.category}/${s.slug}/`;
const crumbs = [
  { label: categoryNames[s.category], href: `/${s.category}/` },
  { label: s.name, href: `/${s.category}/${s.slug}/` },
];
const coupon = couponById(s.coupon);
const pickedReviews =
  s.photo === 'miniIndoor' || s.slug.includes('mini')
    ? reviews.filter((r) => r.topic === 'mini-split' || r.topic === 'general')
    : s.slug.includes('installation')
      ? reviews.filter((r) => r.topic === 'install' || r.topic === 'general')
      : reviews.filter((r) => r.topic === 'general' || r.topic === 'mini-split');
const related = s.related.map((href) => ({ href, svc: findByHref(href) }));
const steps = ['Diagnose', 'Upfront Price', 'You Decide', 'We Fix It Right'];
const isCommercial = s.audience === 'business';
const serviceShort = s.name.replace(/^Commercial /, '');
---
<BaseLayout
  title={s.title}
  description={s.meta}
  crumbs={crumbs}
  schema={[
    serviceNode(url, { name: s.name, serviceType: s.serviceType, description: plain(s.quickAnswer), audience: s.audience }),
    faqNode(url, s.faqs),
  ]}
>
  <PageHero eyebrow={isCommercial ? 'Commercial HVAC · Southern Utah' : `${categoryNames[s.category]} · Southern Utah`} h1={s.h1} sub={s.sub} photo={s.photo} />

  <!-- Quick answer + intro -->
  <section class="section bg-white !pb-8">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_340px]">
      <div>
        <div class="rule-top paper rounded-md p-6" id="quick-answer">
          <p class="eyebrow">Quick answer</p>
          <p class="mt-2 text-lg leading-relaxed text-ink">{s.quickAnswer}</p>
        </div>
        <div class="prose-uh mt-8">
          {s.intro.map((p) => <p set:html={md(p)} />)}
        </div>
      </div>
      <div class="lg:self-start">
        <CouponCard coupon={coupon} headingLevel="h2" />
      </div>
    </div>
  </section>

  <!-- Signs -->
  <section class="section bg-white !pt-6">
    <div class="wrap grid gap-10 lg:grid-cols-2 lg:items-start">
      <div>
        <h2>{s.signsHeading}</h2>
        <ul class="check-list mt-6 space-y-3 text-[1.05rem]">
          {s.signs.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <Photo name={s.photo} alt={s.photoAlt} />
    </div>
  </section>

  <!-- Process -->
  <section class="section bg-teal text-white on-dark">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-1 text-white">Our {serviceShort} Process</h2>
      <ol class="mt-8 grid gap-px overflow-hidden rounded-md bg-white/15 md:grid-cols-2 lg:grid-cols-4">
        {s.process.map((p, i) => (
          <li class="bg-teal p-6">
            <span class="font-display text-5xl font-bold leading-none text-sand">{i + 1}</span>
            <h3 class="mt-3 text-white">{steps[i]}</h3>
            <p class="mt-2 text-white/85">{p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Local -->
  <section class="paper section">
    <div class="wrap grid gap-10 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <h2>{s.localHeading}</h2>
        <div class="prose-uh mt-5">{s.local.map((p) => <p set:html={md(p)} />)}</div>
      </div>
      <div>
        {s.extra && (
          <div class="rounded-md border border-line bg-white p-6">
            <h2 class="text-[1.7rem]">{s.extra.heading}</h2>
            {s.extra.body?.map((p) => <p class="mt-3 text-ink-soft" set:html={md(p)} />)}
            {s.extra.list && <ul class="check-list mt-4 space-y-2">{s.extra.list.map((t) => <li>{t}</li>)}</ul>}
            {s.extra.table && (
              <div class="prose-uh mt-4 max-w-none overflow-x-auto">
                <table>
                  <thead><tr>{s.extra.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                  <tbody>{s.extra.table.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
                </table>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </section>

  {s.more && (
    <section class="section bg-white !pb-0">
      <div class="wrap">
        <h2>{s.more.heading}</h2>
        <div class="prose-uh mt-5">{s.more.body.map((p) => <p set:html={md(p)} />)}</div>
      </div>
    </section>
  )}

  <!-- Why us -->
  <section class="section bg-white">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <Photo name="corbinWorking" />
      <div>
        <p class="eyebrow">Locally owned · Not a franchise</p>
        <h2 class="mt-1">Why Choose Utah Heritage HVAC for {serviceShort}</h2>
        <div class="prose-uh mt-5">{s.whyUs.map((p) => <p set:html={md(p)} />)}</div>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-display text-lg font-semibold uppercase text-teal">
          {['Licensed & insured', 'Upfront pricing', 'No travel fees'].map((t) => <li class="flex items-center gap-2"><Icon name="check" size={20} class="text-rust" />{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Maintenance promo -->
  {s.slug !== 'maintenance-plans' && (
    <section class="paper section !py-12">
      <div class="wrap"><MaintenancePromo commercial={isCommercial} /></div>
    </section>
  )}

  <!-- Reviews -->
  <section class="section bg-white">
    <div class="wrap">
      <ReviewCards items={pickedReviews} limit={2} heading="What Customers Say" />
    </div>
  </section>

  <CTABand photo={s.photo} />

  <!-- FAQs -->
  <section class="section bg-white">
    <div class="wrap max-w-4xl">
      <FAQ faqs={s.faqs} heading={`${s.name} FAQs`} />
    </div>
  </section>

  <!-- Areas -->
  <section class="paper section">
    <div class="wrap">
      <ServiceAreaList heading={`${serviceShort} Across Southern Utah`} intro={`${business.name} provides ${serviceShort.toLowerCase()} in every town below, with no travel fees.`} showMap={false} />
    </div>
  </section>

  <!-- Related + form -->
  <section class="section bg-white">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.5fr]">
      <div>
        <h2>Related Services</h2>
        <ul class="mt-6 divide-y divide-line border-y border-line">
          {related.map(({ href, svc }) => (
            <li>
              <a href={href} class="group flex items-start justify-between gap-4 py-4 no-underline">
                <span>
                  <span class="block font-display text-xl font-semibold text-teal group-hover:text-rust-dark">{svc?.name ?? 'Maintenance Plan'}</span>
                  <span class="block text-[0.98rem] text-ink-soft">{svc?.short ?? 'Two visits a year: spring for cooling, fall for heating.'}</span>
                </span>
                <Icon name="arrow" size={22} class="mt-1 shrink-0 text-rust" />
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-ink-soft">Last updated: <time datetime={LAST_UPDATED}>{formatDate(LAST_UPDATED)}</time></p>
      </div>
      <ContactForm defaultService={isCommercial ? 'Commercial service' : ''} heading={`Request ${serviceShort}`} />
    </div>
  </section>
</BaseLayout>
