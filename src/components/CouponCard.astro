---
import type { Coupon } from '../data/coupons';
import { business } from '../data/business';
interface Props { coupon: Coupon; compact?: boolean; headingLevel?: 'h2' | 'h3' }
const { coupon, compact = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="relative flex h-full flex-col rounded-md border-2 border-dashed border-rust bg-white p-1.5">
  <div class="flex h-full flex-col rounded-sm bg-cream px-5 pb-5 pt-4">
    <p class="eyebrow">Coupon</p>
    <H class="mt-1 text-2xl">{coupon.title}</H>
    <p class:list={['mt-2 font-display font-bold leading-tight text-rust-dark', compact ? 'text-xl' : 'text-2xl']}>{coupon.offer}</p>
    {!compact && <p class="mt-2 text-[0.95rem] leading-snug text-ink-soft">{coupon.fine}</p>}
    <p class="mt-3 text-sm text-ink-soft">Expires: {coupon.expires}</p>
    <div class="mt-auto flex flex-wrap gap-2 pt-4">
      <a href={`/contact/?coupon=${coupon.id}#request`} class="btn btn-rust btn-sm">Redeem</a>
      <a href={business.phoneHref} class="btn btn-outline btn-sm" data-call>Call to Redeem</a>
    </div>
  </div>
  <span aria-hidden="true" class="absolute -left-[11px] top-1/2 h-5 w-5 -translate-y-1/2 rounded-full border-2 border-dashed border-rust bg-white [clip-path:inset(0_0_0_50%)]"></span>
  <span aria-hidden="true" class="absolute -right-[11px] top-1/2 h-5 w-5 -translate-y-1/2 rounded-full border-2 border-dashed border-rust bg-white [clip-path:inset(0_50%_0_0)]"></span>
</article>
