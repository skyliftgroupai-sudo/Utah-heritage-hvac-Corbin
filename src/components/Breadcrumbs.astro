---
export interface Crumb { label: string; href: string }
interface Props { items: Crumb[]; dark?: boolean }
const { items, dark = false } = Astro.props;
const all = [{ label: 'Home', href: '/' }, ...items];
---
<nav aria-label="Breadcrumb" class:list={['text-[0.95rem]', dark ? 'text-white/80' : 'text-ink-soft']}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {all.map((c, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class={dark ? 'text-sand' : 'text-rust'}>›</span>}
        {i === all.length - 1
          ? <span aria-current="page" class={dark ? 'font-semibold text-white' : 'font-semibold text-ink'}>{c.label}</span>
          : <a href={c.href} class:list={['underline-offset-2 hover:underline', dark ? 'text-white/85' : 'text-rust-dark']}>{c.label}</a>}
      </li>
    ))}
  </ol>
</nav>
