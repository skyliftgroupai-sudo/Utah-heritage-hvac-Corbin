---
import { cityList, cityHref } from '../data/areas-list';
import Icon from './Icon.astro';
interface Props { heading?: string; intro?: string; showMap?: boolean; headingLevel?: 'h2' | 'h3'; service?: string }
const {
  heading = 'Areas We Serve',
  intro = 'We cover Washington County and Iron County from St. George up to Cedar City. No travel fees anywhere in our service area.',
  showMap = true,
  headingLevel = 'h2',
  service,
} = Astro.props;
const H = headingLevel;
// Positions projected from real lat/long onto a 400×380 box (lng −113.85…−112.95, lat 36.95…37.80).
const pins: Record<string, [number, number, 'l' | 'r']> = {
  'st-george': [125, 314, 'r'],
  washington: [152, 299, 'r'],
  hurricane: [249, 279, 'r'],
  'santa-clara': [87, 298, 'l'],
  ivins: [76, 282, 'l'],
  enterprise: [58, 101, 'r'],
  'cedar-city': [350, 55, 'l'],
};
---
<div class:list={['grid gap-10', showMap && 'lg:grid-cols-[1fr_420px] lg:items-center']}>
  <div>
    <H>{heading}</H>
    <p class="mt-3 max-w-2xl text-ink-soft">{intro}</p>
    <ul class="mt-6 grid gap-x-6 sm:grid-cols-2">
      {cityList.map((c) => (
        <li class="border-b border-line">
          <a href={cityHref(c.slug)} class="group flex items-center justify-between py-3 no-underline">
            <span class="flex items-center gap-2 font-display text-xl font-semibold text-teal group-hover:text-rust-dark">
              <Icon name="map-pin" size={20} class="text-rust" />{service ? `${service} in ${c.name}` : `${c.name}, UT`}
            </span>
            <span class="text-sm text-ink-soft">{c.county}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  {showMap && (
    <figure class="paper rounded-md border border-line p-3">
      <svg viewBox="0 0 400 380" role="img" aria-labelledby="sa-map-title" class="h-auto w-full">
        <title id="sa-map-title">Map of the Utah Heritage HVAC service area: St. George, Washington, Hurricane, Santa Clara and Ivins in Washington County, Enterprise, and Cedar City in Iron County</title>
        <path d="M0 88 H182 V150 H400" fill="none" stroke="#9c8f77" stroke-width="1.5" stroke-dasharray="6 5" />
        <text x="392" y="140" text-anchor="end" font-size="11" letter-spacing="2" fill="#6b5f4a" font-family="Barlow Condensed, sans-serif" font-weight="700">IRON COUNTY</text>
        <text x="392" y="168" text-anchor="end" font-size="11" letter-spacing="2" fill="#6b5f4a" font-family="Barlow Condensed, sans-serif" font-weight="700">WASHINGTON COUNTY</text>
        <path d="M110 372 L125 314 L152 299 L222 246 L270 190 L298 121 L350 55 L372 10" fill="none" stroke="#d9a273" stroke-width="5" stroke-linecap="round" />
        <g transform="translate(276 214)"><rect x="-13" y="-9" width="26" height="18" rx="3" fill="#123f3e" /><text y="4.5" text-anchor="middle" font-size="11" fill="#fff" font-family="Barlow Condensed, sans-serif" font-weight="700">I-15</text></g>
        <path d="M50 250 q20 -30 45 -18 q22 -40 55 -12 l-8 14 q-30 -12 -48 8 q-22 -8 -44 8 z" fill="#b5522b" opacity=".18" />
        {cityList.map((c) => {
          const [x, y, side] = pins[c.slug]!;
          return (
            <a href={cityHref(c.slug)} aria-label={`${c.name}, UT`}>
              <circle cx={x} cy={y} r="7" fill="#b5522b" stroke="#fff" stroke-width="2.5" />
              <text x={side === 'r' ? x + 12 : x - 12} y={y + (c.slug === 'washington' ? -8 : 5)} text-anchor={side === 'r' ? 'start' : 'end'} font-size="16" fill="#123f3e" font-family="Barlow Condensed, sans-serif" font-weight="700">{c.name}</text>
            </a>
          );
        })}
      </svg>
      <figcaption class="px-1 pt-1 text-sm text-ink-soft">Schematic map, not to scale. We come to you; there is no storefront.</figcaption>
    </figure>
  )}
</div>
