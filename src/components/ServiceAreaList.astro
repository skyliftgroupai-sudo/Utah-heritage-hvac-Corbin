---
import { cityList, cityHref } from '../data/areas-list';
import Icon from './Icon.astro';
import GoogleMap from './GoogleMap.astro';
import { business } from '../data/business';
interface Props { heading?: string; intro?: string; showMap?: boolean; headingLevel?: 'h2' | 'h3'; service?: string }
const {
  heading = 'Areas We Serve',
  intro = 'We cover Washington County and Iron County from St. George up to Cedar City. No travel fees anywhere in our service area.',
  showMap = true,
  headingLevel = 'h2',
  service,
} = Astro.props;
const H = headingLevel;
---
<div class:list={['grid gap-10', showMap && 'lg:grid-cols-[1fr_460px] lg:items-center']}>
  <div>
    <H>{heading}</H>
    <p class="mt-3 max-w-2xl text-ink-soft">{intro}</p>
    <ul class="mt-6 grid gap-x-6 sm:grid-cols-2">
      {cityList.map((c) => (
        <li class="border-b border-line">
          <a href={cityHref(c.slug)} class="group flex items-center justify-between py-3 no-underline">
            <span class="flex items-center gap-2 font-display text-xl font-semibold text-teal group-hover:text-rust-dark">
              <Icon name="map-pin" size={20} class="text-rust" />{service ? `${service} in ${c.name}` : `${c.name}, UT`}
            </span>
            <span class="text-sm text-ink-soft">{c.county}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  {showMap && (
    <GoogleMap
      query={business.gbpName}
      zoom={8}
      height={400}
      openUrl={business.social.gbp}
      openLabel="View on Google"
      title={`Google Maps listing for ${business.name}, serving Washington County and Iron County, Utah`}
      caption={`${business.name} · St. George to Cedar City`}
    />
  )}
</div>
