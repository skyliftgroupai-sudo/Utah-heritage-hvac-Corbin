---
import { mainNav } from '../data/nav';
import Icon from './Icon.astro';
const current = Astro.url.pathname;
---
<nav aria-label="Main" class="hidden lg:block">
  <ul class="flex items-stretch">
    {mainNav.map((item, i) => {
      const active = current === item.href || (item.children && current.startsWith(item.href));
      return item.children ? (
        <li class="dd relative flex items-stretch" data-dd>
          <div class="flex items-center">
            <a
              href={item.href}
              class:list={['dd-link flex h-full items-center whitespace-nowrap py-6 pl-2.5 pr-1 font-display text-[1.06rem] font-bold uppercase tracking-wide text-white no-underline hover:text-sand xl:pl-3.5', active && 'text-sand']}
              aria-current={current === item.href ? 'page' : undefined}
            >{item.label}</a>
            <button
              type="button"
              class="dd-toggle -ml-0.5 mr-1 flex h-8 w-6 items-center justify-center rounded-sm text-rust hover:text-sand"
              aria-expanded="false"
              aria-controls={`dd-${i}`}
              aria-label={`${item.label} submenu`}
            ><Icon name="caret" size={16} class="text-[#e07a4f]" /></button>
          </div>
          <div id={`dd-${i}`} class="dd-panel absolute left-0 top-full z-50 min-w-[290px] border-t-[3px] border-rust bg-white py-2 shadow-[0_12px_28px_-14px_rgba(0,0,0,.45)]">
            <a href={item.href} class="mx-2 mb-1 block whitespace-nowrap border-b border-line px-3 pb-2.5 pt-2 font-display text-[0.95rem] font-bold uppercase tracking-[0.08em] text-teal no-underline hover:text-rust-dark">
              {item.label === 'Service Areas' ? 'All Service Areas' : `All ${item.label} Services`}
            </a>
            <ul>
              {item.children.map((c) => (
                <li>
                  <a
                    href={c.href}
                    class:list={['dd-item block whitespace-nowrap border-l-[3px] border-transparent px-5 py-2 text-[1rem] leading-snug text-ink no-underline hover:border-rust hover:bg-cream hover:text-rust-dark', current === c.href && 'border-rust font-semibold text-rust-dark']}
                    aria-current={current === c.href ? 'page' : undefined}
                  >{c.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ) : (
        <li class="flex items-stretch">
          <a
            href={item.href}
            class:list={['flex items-center whitespace-nowrap px-2.5 py-6 font-display text-[1.06rem] font-bold uppercase tracking-wide text-white no-underline hover:text-sand xl:px-3.5', active && 'text-sand']}
            aria-current={current === item.href ? 'page' : undefined}
          >{item.label}</a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .dd-panel { display: none; }
  .dd:hover > .dd-panel,
  .dd:focus-within > .dd-panel,
  .dd[data-open='true'] > .dd-panel { display: block; }
  .dd[data-suppress] > .dd-panel { display: none !important; }
  .dd:hover .dd-link, .dd[data-open='true'] .dd-link { color: var(--color-sand); }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-dd]');
  const closeAll = (except?: HTMLElement) =>
    items.forEach((li) => {
      if (li === except) return;
      li.dataset.open = 'false';
      li.querySelector('.dd-toggle')?.setAttribute('aria-expanded', 'false');
    });
  items.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.dd-toggle')!;
    btn.addEventListener('click', () => {
      const open = li.dataset.open !== 'true';
      closeAll(li);
      li.dataset.open = String(open);
      delete li.dataset.suppress;
      btn.setAttribute('aria-expanded', String(open));
    });
    li.addEventListener('mouseenter', () => { delete li.dataset.suppress; btn.setAttribute('aria-expanded', 'true'); });
    li.addEventListener('mouseleave', () => { if (li.dataset.open !== 'true') btn.setAttribute('aria-expanded', 'false'); });
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node)) {
        li.dataset.open = 'false';
        delete li.dataset.suppress;
        btn.setAttribute('aria-expanded', 'false');
      }
    });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        li.dataset.open = 'false';
        li.dataset.suppress = '1';
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-dd]')) closeAll();
  });
</script>
