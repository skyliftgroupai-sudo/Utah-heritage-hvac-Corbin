---
import { reviews as all, type Review } from '../data/reviews';
import { business } from '../data/business';
import Icon from './Icon.astro';
interface Props { items?: Review[]; limit?: number; heading?: string; showLink?: boolean }
const { items = all, limit = 3, heading, showLink = true } = Astro.props;
const list = items.slice(0, limit);
---
<div>
  {heading && <h2>{heading}</h2>}
  <div class:list={['mt-6 grid gap-5', list.length > 1 ? 'md:grid-cols-2 lg:grid-cols-3' : '']}>
    {list.map((r) => (
      <figure class="flex h-full flex-col rounded-md border border-line border-l-4 border-l-rust bg-white p-6">
        <div class="flex gap-0.5 text-rust" aria-label="Five-star Google review" role="img">
          {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={18} class="fill-current" />)}
        </div>
        <blockquote class="mt-3 flex-1 text-[1.02rem] leading-relaxed text-ink-soft">
          <p>“{r.text}”</p>
        </blockquote>
        <figcaption class="mt-4 flex items-center justify-between border-t border-line pt-3">
          <span class="font-display text-lg font-bold uppercase tracking-wide text-teal">{r.author}</span>
          <span class="flex items-center gap-1 text-sm text-ink-soft"><Icon name="google" size={16} />Google review</span>
        </figcaption>
      </figure>
    ))}
  </div>
  {showLink && (
    <p class="mt-6"><a href={business.gbpReviewsUrl} target="_blank" rel="noopener" class="link">Read all reviews on Google</a></p>
  )}
</div>
