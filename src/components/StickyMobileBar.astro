---
import { business } from '../data/business';
import Icon from './Icon.astro';
---
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t-2 border-rust bg-teal-900 text-white lg:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
  <a href="/contact/#request" class="flex flex-col items-center justify-center gap-0.5 py-2 font-display text-sm font-bold uppercase tracking-wide no-underline">
    <Icon name="calendar" size={20} class="text-sand" />Schedule
  </a>
  <a href={business.phoneHref} class="flex flex-col items-center justify-center gap-0.5 bg-rust py-2 font-display text-sm font-bold uppercase tracking-wide no-underline" data-call>
    <Icon name="phone" size={20} />Call
  </a>
  <a href="/coupons/" class="flex flex-col items-center justify-center gap-0.5 py-2 font-display text-sm font-bold uppercase tracking-wide no-underline">
    <Icon name="tag" size={20} class="text-sand" />Offers
  </a>
</div>
