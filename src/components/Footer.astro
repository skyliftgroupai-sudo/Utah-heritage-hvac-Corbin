---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.webp';
import { business } from '../data/business';
import { mainNav, companyLinks } from '../data/nav';
import { cityList, cityHref } from '../data/areas-list';
import Icon from './Icon.astro';
const groups = mainNav.filter((g) => g.children && g.href !== '/service-areas/');
const year = new Date().getFullYear();
const socials = [
  { name: 'Facebook', href: business.social.facebook, icon: 'facebook' as const },
  { name: 'Instagram', href: business.social.instagram, icon: 'instagram' as const },
  { name: 'Google Business Profile', href: business.social.gbp || business.gbpReviewsUrl, icon: 'google' as const },
].filter((s) => s.href);
---
<footer class="on-dark bg-teal text-white/85">
  <div class="h-1.5 bg-[linear-gradient(90deg,var(--color-rust)_0_33%,var(--color-sand)_33%_66%,var(--color-teal-700)_66%)]"></div>
  <div class="wrap grid gap-10 py-14 lg:grid-cols-[300px_1fr]">
    <div>
      <a href="/" class="inline-flex items-center gap-3 no-underline" aria-label={`${business.name} home`}>
        <Image src={logo} alt="" width={72} height={72} densities={[1, 2]} class="h-[72px] w-[72px] rounded-md" />
        <span class="font-display text-2xl font-bold uppercase leading-none text-white">Utah Heritage<br />HVAC</span>
      </a>
      <p class="mt-4 text-base">{business.blurb}</p>
      <ul class="mt-5 space-y-2 text-base">
        <li><a href={business.phoneHref} class="flex items-center gap-2 font-semibold text-white no-underline hover:text-sand" data-call><Icon name="phone" size={18} class="text-sand" />{business.phone}</a></li>
        <li><a href={`mailto:${business.email}`} class="flex items-center gap-2 no-underline hover:text-sand"><Icon name="mail" size={18} class="text-sand" />{business.email}</a></li>
        <li class="flex items-start gap-2"><Icon name="clock" size={18} class="mt-1 text-sand" /><span>{business.hours.map((h) => <span class="block">{h.days}: {h.open ? `${h.open} – ${h.close}` : 'Closed'}</span>)}<span class="block">{business.emergencyLine}</span></span></li>
        <li class="flex items-center gap-2"><Icon name="shield" size={18} class="text-sand" />Licensed &amp; Insured{business.licenseNumber && ` · License #${business.licenseNumber}`}</li>
      </ul>
      <a href="/contact/#request" class="btn btn-rust mt-6">Request Service</a>
    </div>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
      {groups.map((g) => (
        <div>
          <p class="font-display text-lg font-bold uppercase tracking-wide text-white"><a href={g.href} class="no-underline hover:text-sand">{g.label}</a></p>
          <ul class="mt-3 space-y-1.5 text-[0.95rem]">
            {g.children!.map((c) => <li><a href={c.href} class="no-underline hover:text-sand hover:underline">{c.label}</a></li>)}
          </ul>
        </div>
      ))}
      <div>
        <p class="font-display text-lg font-bold uppercase tracking-wide text-white">Company</p>
        <ul class="mt-3 space-y-1.5 text-[0.95rem]">
          {companyLinks.map((c) => <li><a href={c.href} class="no-underline hover:text-sand hover:underline">{c.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="wrap flex flex-col gap-4 py-6 text-[0.95rem] lg:flex-row lg:items-center lg:justify-between">
      <p><span class="font-semibold text-white">Service areas:</span>{' '}
        {cityList.map((c, i) => <>{i > 0 && ' · '}<a href={cityHref(c.slug)} class="no-underline hover:text-sand hover:underline">{c.name}</a></>)}
        {' '}+ surrounding Washington &amp; Iron County
      </p>
      <ul class="flex gap-3">
        {socials.map((s) => <li><a href={s.href} rel="noopener" target="_blank" class="flex h-10 w-10 items-center justify-center rounded-md border border-white/30 hover:border-sand hover:text-sand" aria-label={`${business.name} on ${s.name}`}><Icon name={s.icon} size={20} /></a></li>)}
      </ul>
    </div>
  </div>
  <div class="bg-teal-900 pb-20 lg:pb-0">
    <div class="wrap flex flex-col gap-1 py-4 text-sm text-white/70 sm:flex-row sm:justify-between">
      <p>© {year} {business.name}. All rights reserved.</p>
      <p>{business.longName} · {business.phone} · {business.email}</p>
    </div>
  </div>
</footer>
