---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FAQ from '../../components/FAQ.astro';
import CTABand from '../../components/CTABand.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import { services, categoryNames, findByHref } from '../../data/services';
import { faqPages } from '../../data/faq-pages';
import { SITE_URL, LAST_UPDATED, formatDate } from '../../data/business';
import { faqNode } from '../../lib/schema';
import type { Service, FaqPage } from '../../data/types';

export function getStaticPaths() {
  return [
    ...services.map((s) => ({ params: { category: s.category, slug: s.slug }, props: { kind: 'service' as const, s } })),
    ...faqPages.map((p) => ({ params: { category: p.category, slug: p.slug }, props: { kind: 'faq' as const, p } })),
  ];
}
type Props = { kind: 'service'; s: Service } | { kind: 'faq'; p: FaqPage };
const props = Astro.props;
const p = props.kind === 'faq' ? props.p : null;
const url = p ? `${SITE_URL}/${p.category}/faqs/` : '';
const allFaqs = p ? p.groups.flatMap((g) => g.faqs) : [];
---
{props.kind === 'service' ? (
  <ServiceLayout s={props.s} />
) : p && (
  <BaseLayout
    title={p.title}
    description={p.meta}
    crumbs={[{ label: categoryNames[p.category], href: `/${p.category}/` }, { label: p.name, href: `/${p.category}/faqs/` }]}
    schema={[faqNode(url, allFaqs)]}
    pageType="FAQPage"
  >
    <PageHero eyebrow={`${categoryNames[p.category]} questions`} h1={p.h1} sub={p.sub} photo={p.category === 'heating' ? 'furnaceGas' : 'acCondenser'} />
    <section class="section bg-white">
      <div class="wrap grid gap-12 lg:grid-cols-[1fr_300px]">
        <div>
          <p class="prose-uh text-lg">{p.intro}</p>
          {p.groups.map((g, i) => (
            <div class="mt-10">
              <FAQ faqs={g.faqs} heading={g.heading} id={`faq-${i}`} />
            </div>
          ))}
          <p class="mt-10 text-sm text-ink-soft">Last updated: <time datetime={LAST_UPDATED}>{formatDate(LAST_UPDATED)}</time></p>
        </div>
        <aside class="h-fit lg:sticky lg:top-28">
          <div class="rule-top paper rounded-md p-5">
            <h2 class="text-2xl">Jump to a Topic</h2>
            <ul class="mt-3 space-y-1">{p.groups.map((g, i) => <li><a href={`#faq-${i}`} class="link">{g.heading}</a></li>)}</ul>
            <h2 class="mt-6 text-2xl">Related Services</h2>
            <ul class="mt-3 space-y-2">
              {p.related.map((href) => <li><a href={href} class="flex items-center gap-2 no-underline hover:text-rust-dark"><Icon name="arrow" size={16} class="text-rust" />{findByHref(href)?.name ?? 'Maintenance Plan'}</a></li>)}
            </ul>
          </div>
        </aside>
      </div>
    </section>
    <CTABand />
    <section class="section bg-white">
      <div class="wrap max-w-3xl"><ContactForm heading="Still Have a Question? Ask Us" /></div>
    </section>
  </BaseLayout>
)}
